{"lines":[{"id":"s1","text":"Tray first.|New plate every round."},{"id":"s2","text":"All froze.|Wrong plate."},{"id":"s3","text":"Seconds?|Not like that."},{"id":"s4","text":"Same hands.|Fresh plate."},{"id":"s5","text":"Tray in hand.|Plate on top."},{"id":"s6","text":"She pointed—"},{"id":"s7","text":"They keep eating.|We just wait."},{"id":"s8","text":"Fresh plate,|full tray."},{"id":"s9","text":"New plate.|Every round."},{"id":"n1","text":"The tray|comes first."},{"id":"n2","text":"Fresh plate|every round."},{"id":"n3","text":"Dirty plate?|Leave it here."},{"id":"n4","text":"That's Japan first times.|Follow for more."}],"rate":"+8%","voice":"en-US-GuyNeural"}