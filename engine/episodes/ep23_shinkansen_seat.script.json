{"lines":[{"id":"s1","text":"Check your seat number.|It's someone else's."},{"id":"s2","text":"All eyes on you.|Wrong seat."},{"id":"s3","text":"Reserved.|Not yours."},{"id":"s4","text":"Ticket out.|Find your seat."},{"id":"s5","text":"The owner arrives.|Ticket in hand."},{"id":"s6","text":"She said—"},{"id":"s7","text":"You stand.|The train rolls on."},{"id":"s8","text":"Free seats.|You sit down."},{"id":"s9","text":"Reserved means reserved.|Even the empty ones."},{"id":"n1","text":"Check the number.|Before you sit."},{"id":"n2","text":"Reserved seats|belong to someone."},{"id":"n3","text":"No number?|Ride the free car."},{"id":"n4","text":"That's Japan first times.|Follow for more."}],"rate":"+8%","voice":"en-US-GuyNeural"}